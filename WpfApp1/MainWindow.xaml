<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulation Robot"
        Width="1200"
        Height="750"
        Background="#202020">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="10"
                Background="#303030"
                BorderBrush="#555555"
                BorderThickness="1">

            <Canvas x:Name="SimulationCanvas"
                    Background="#303030">

                <!-- Robot -->
                <Polygon x:Name="RobotTriangle"
                         Fill="DodgerBlue"
                         Stroke="White"
                         StrokeThickness="2"/>

                <Line x:Name="RobotAxis"
                      Stroke="Yellow"
                      StrokeThickness="2"/>

                <!-- Waypoint effectif -->
                <Ellipse x:Name="WaypointMarker"
                         Width="14"
                         Height="14"
                         Fill="Red"
                         Stroke="White"
                         StrokeThickness="2"/>

                <!-- Projection du waypoint effectif -->
                <Ellipse x:Name="ProjectionMarker"
                         Width="10"
                         Height="10"
                         Fill="LimeGreen"
                         Stroke="White"
                         StrokeThickness="1"/>

                <Line x:Name="ProjectionLine"
                      Stroke="LimeGreen"
                      StrokeThickness="2"
                      StrokeDashArray="5,5"/>

                <!-- Target original -->
                <Ellipse x:Name="TargetMarker"
                         Width="14"
                         Height="14"
                         Fill="Orange"
                         Stroke="White"
                         StrokeThickness="2"
                         Visibility="Collapsed"/>

                <TextBlock x:Name="TargetLabel"
                           Text="Target"
                           Foreground="Orange"
                           FontWeight="Bold"
                           FontSize="14"
                           Visibility="Collapsed"/>

                <!-- Projection du Target sur l'axe du robot -->
                <Ellipse x:Name="TargetProjectionMarker"
                         Width="10"
                         Height="10"
                         Fill="Orange"
                         Stroke="White"
                         StrokeThickness="1"
                         Visibility="Collapsed"/>

                <Line x:Name="TargetProjectionLine"
                      Stroke="Orange"
                      StrokeThickness="2"
                      StrokeDashArray="5,5"
                      Visibility="Collapsed"/>

            </Canvas>
        </Border>

        <Border Grid.Column="1"
                Margin="10"
                Padding="15"
                Background="#252525"
                CornerRadius="5">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="SIMULATION ROBOT"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Position du robot"
                               Foreground="LightGray"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="RobotPositionText"
                               Foreground="White"
                               FontSize="15"
                               Margin="0,5,0,15"/>

                    <TextBlock Text="Orientation"
                               Foreground="LightGray"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="RobotAngleText"
                               Foreground="White"
                               FontSize="15"
                               Margin="0,5,0,15"/>

                    <TextBlock Text="Waypoint"
                               Foreground="LightGray"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="WaypointText"
                               Foreground="White"
                               FontSize="15"
                               Margin="0,5,0,15"/>

                    <TextBlock Text="Projection sur l'axe"
                               Foreground="LightGray"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="ProjectionText"
                               Foreground="LimeGreen"
                               FontSize="15"
                               Margin="0,5,0,15"/>

                    <TextBlock x:Name="DistanceText"
                               Foreground="White"
                               FontSize="15"
                               Margin="0,5,0,20"/>

                    <TextBlock Text="Écart angulaire"
                               Foreground="LightGray"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBox x:Name="AngleOffsetTextBox"
                             Text="0"
                             FontSize="16"
                             Margin="0,5,0,5"/>

                    <TextBlock Text="rad"
                               Foreground="Gray"
                               Margin="0,0,0,15"/>

                    <CheckBox x:Name="AngleOffsetCheckBox"
                              Content="Activer l'écart angulaire"
                              Foreground="White"
                              FontSize="14"
                              Margin="0,0,0,20"
                              Checked="AngleOffsetCheckBox_Changed"
                              Unchecked="AngleOffsetCheckBox_Changed"/>

                    <TextBlock Text="Waypoints"
                               Foreground="LightGray"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Button Content="Waypoint 1 : (4, 4)"
                            Height="40"
                            Margin="0,3"
                            Click="Waypoint1_Click"/>

                    <Button Content="Waypoint 2 : (10, 15)"
                            Height="40"
                            Margin="0,3"
                            Click="Waypoint2_Click"/>

                    <Button Content="Waypoint 3 : (15, 5)"
                            Height="40"
                            Margin="0,3"
                            Click="Waypoint3_Click"/>

                    <Button Content="Waypoint 4 : (3, 17)"
                            Height="40"
                            Margin="0,3"
                            Click="Waypoint4_Click"/>

                    <Button Content="STOP"
                            Height="45"
                            Margin="0,20,0,5"
                            Background="DarkRed"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Stop_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>